{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://skujqujylfugqopsudrn.supabase.co; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "outputDirectory": "web",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "functions": {
    "api/publication-emails.js": {
      "maxDuration": 60
    },
    "api/outlook-connect.js": {
      "maxDuration": 60
    },
    "api/priority-reminders.js": {
      "maxDuration": 60
    },
    "api/priority-reminders-cron.js": {
      "maxDuration": 60
    },
    "api/forward-email.js": {
      "maxDuration": 60
    },
    "api/publication-ingest.js": {
      "maxDuration": 60
    },
    "api/analyze-publication.js": {
      "maxDuration": 60
    },
    "api/staff-accounts.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/priority-reminders-cron",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/controladoria",
      "destination": "/index.html"
    },
    {
      "source": "/controladoria/",
      "destination": "/index.html"
    }
  ]
}
